# Robinhood Chain RPC used by the server (e.g. a Quicknode endpoint). Defaults to the public RPC.
RPC_URL=
NEXT_PUBLIC_RPC_URL=
# Log queries (agents, ledger). Quicknode caps eth_getLogs at 10,000 blocks, so this defaults to the public RPC.
LOGS_RPC_URL=

# Printed by `pnpm seed` (also written to .env.seed.local)
NEXT_PUBLIC_MARKET_ADDRESS=
NEXT_PUBLIC_MARKET_DEPLOY_BLOCK=
NEXT_PUBLIC_ROUTER_ADDRESS=
GUARDIAN_VAULT_ADDRESS=
SCOUT_VAULT_ADDRESS=

# The lead agents' hot key (vault operator: it can only spend through the vaults' rules) and the refund key.
OPERATOR_KEY=
ARBITER_KEY=

# AI for the report and post writers (Vercel AI Gateway). Without it they fall back to rule-based text.
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5-5

# Local dev only: call our own agents here instead of the URLs written on-chain.
AGENTS_BASE_URL=
